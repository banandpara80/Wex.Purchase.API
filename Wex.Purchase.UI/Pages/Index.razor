@page "/"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Wex.Purchase.BusinessModels
@inject IHttpClientFactory HttpClientFactory

<EditForm Model="editModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h3>Create Purchase</h3>

    <div class="mb-3">
        <label>Description</label>
        <InputText @bind-Value="editModel.Description" class="form-control" maxlength="50" />
        <ValidationMessage For="@(() => editModel.Description)" />
    </div>

    <div class="mb-3">
        <label>Transaction Date</label>
        <InputDate @bind-Value="editModel.TransactionDate" class="form-control" />
        <ValidationMessage For="@(() => editModel.TransactionDate)" />
    </div>

    <div class="mb-3">
        <label>Purchase Amount</label>
        <InputNumber @bind-Value="editModel.PurchaseAmount" class="form-control" step="0.01" />
        <ValidationMessage For="@(() => editModel.PurchaseAmount)" />
    </div>

    <button type="submit" class="btn btn-primary">Save Purchase</button>
</EditForm>

<hr />

<h3>Get Purchase by Id</h3>
<div class="mb-3">
    <label>Purchase Id</label>
    <input @bind="queryId" class="form-control" />
</div>
<button class="btn btn-secondary" @onclick="GetPurchase">Get Purchase</button>

@if (savedPurchase != null)
{
    <h4>Saved Purchase</h4>
    <pre>@System.Text.Json.JsonSerializer.Serialize(savedPurchase, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
}

@if (queriedPurchase != null)
{
    <h4>Queried Purchase</h4>
    <pre>@System.Text.Json.JsonSerializer.Serialize(queriedPurchase, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
}

<hr />

<h3>Fetch Transactions with Conversions</h3>
<div class="mb-3">
    <label>Purchase Ids (comma separated)</label>
    <input @bind="idsInput" class="form-control" placeholder="id1,id2,..." />
</div>
<div class="mb-3">
    <label>Currency</label>
    <input @bind="currency" class="form-control" placeholder="Peso" />
</div>
<button class="btn btn-info" @onclick="FetchConversions">Fetch Conversions</button>

@if (convertedTransactions != null && convertedTransactions.Any())
{
    <h4>Converted Transactions</h4>
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Identifier</th>
                <th>Description</th>
                <th>Transaction Date</th>
                <th>Original (USD)</th>
                <th>Exchange Rate Used</th>
                <th>Converted Amount</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in convertedTransactions)
            {
                <tr>
                    <td>@t.Purchase.Id</td>
                    <td>@t.Purchase.Description</td>
                    <td>@t.Purchase.TransactionDate.ToString("yyyy-MM-dd")</td>
                    <td>@(t.Purchase.PurchaseAmount.ToString())</td>
                    <td>@t.ExchangeRate.ToString()</td>
                    <td>@t.ConvertedAmount.ToString()</td>
                    <td>@t.Note.ToString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private PurchaseViewModel editModel = new();
    private string queryId = string.Empty;

    // Fields for conversions UI
    private string idsInput = string.Empty;
    private string currency = string.Empty;
    private List<PurchaseWithExchangeRateDTO>? convertedTransactions;

    private PurchaseDTO? savedPurchase;
    private PurchaseDTO? queriedPurchase;

    protected override void OnInitialized()
    {
        editModel.TransactionDate = DateTime.UtcNow;
    }

    private async Task HandleValidSubmit()
    {
        var client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri("http://localhost:5271/");

        var dto = new PurchaseDTO
        {
            Description = editModel.Description ?? string.Empty,
            PurchaseAmount = editModel.PurchaseAmount,
            TransactionDate = editModel.TransactionDate
        };

        var response = await client.PostAsJsonAsync("api/v1/purchase", dto);
        if (response.IsSuccessStatusCode)
        {
            savedPurchase = await response.Content.ReadFromJsonAsync<PurchaseDTO>();
        }
        else
        {
            var txt = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Error saving: {txt}");
        }
    }

    private async Task GetPurchase()
    {
        var client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri("http://localhost:5271/");

        if (Guid.TryParse(queryId, out var id))
        {
            var response = await client.GetAsync($"api/v1/purchase/{id}");
            if (response.IsSuccessStatusCode)
            {
                queriedPurchase = await response.Content.ReadFromJsonAsync<PurchaseDTO>();
            }
            else
            {
                var txt = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting: {txt}");
            }
        }
    }

    private async Task FetchConversions()
    {
        convertedTransactions = null;

        if (String.IsNullOrEmpty(idsInput))
        {
            // nothing to fetch
            convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
            return;
        }

        if (string.IsNullOrWhiteSpace(currency))
        {
            // no currency provided
            convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
            return;
        }

        var request = new PurchaseRequestDTO
        {
            Ids = idsInput,
            Currency = currency.Trim()
        };

        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri("http://localhost:5271/");

            var response = await client.PostAsJsonAsync("api/v1/purchase/transactions/with-conversions", request);
            if (response.IsSuccessStatusCode)
            {
                convertedTransactions = await response.Content.ReadFromJsonAsync<List<PurchaseWithExchangeRateDTO>>();
            }
            else
            {
                var txt = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error fetching conversions: {txt}");
                convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception fetching conversions: {ex.Message}");
            convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
        }
    }

    private class PurchaseViewModel
    {
        [Required(ErrorMessage = "Description is required.")]
        [StringLength(50, ErrorMessage = "Description cannot exceed 50 characters.")]
        [RegularExpression(@"^[A-Za-z0-9\-\(\),/&\s]+$", ErrorMessage = "Description contains invalid characters. Only letters, numbers, spaces and the characters - ( , ) / & are allowed.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Transaction date is required.")]
        [DataType(DataType.Date)]
        public DateTime TransactionDate { get; set; }

        [Required(ErrorMessage = "Amount is required.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "Amount must be greater than zero.")]
        public decimal PurchaseAmount { get; set; }
    }
}
