@page "/"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Sections
@inject IHttpClientFactory HttpClientFactory

<EditForm Model="editModel" OnValidSubmit="HandleValidSubmit">
   

    <h3>Create Purchase</h3>
    <DataAnnotationsValidator />
    <span style="color: red;"><ValidationSummary /></span>
    @if (apiErrors != null && apiErrors.Any())
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0">
                @foreach (var e in apiErrors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }
    <div class="mb-3">
        <label><span style="color: red;">*</span> Description</label>
        <InputText @bind-Value="editModel.Description" class="form-control" maxlength="50" required />
    </div>

    <div class="mb-3">
        <label><span style="color: red;">*</span> Transaction Date</label>
        <InputDate @bind-Value="editModel.TransactionDate" class="form-control" required />
    </div>

    <div class="mb-3">
        <label><span style="color: red;">*</span> Purchase Amount</label>
        <InputNumber @bind-Value="editModel.PurchaseAmount" class="form-control" step="0.01" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Purchase</button>
</EditForm>
@if (savedPurchase != null)
{
    <h4>Saved Purchase</h4>
    <pre>@System.Text.Json.JsonSerializer.Serialize(savedPurchase, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
}

<hr />

<h3>Get Purchase by Id</h3>
<div class="mb-3">
    <label><span style="color: red;">*</span>Purchase Id</label>
    <input @bind="queryId" class="form-control" required />
</div>
<button class="btn btn-secondary" @onclick="GetPurchase">Get Purchase</button>



@if (queriedPurchase != null)
{
    <h4>Queried Purchase</h4>
    <pre>@System.Text.Json.JsonSerializer.Serialize(queriedPurchase, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
}

<hr />


<EditForm Model="purchaseRequestModel" OnValidSubmit="FetchConversions">

<h3>Fetch Transactions with Conversions</h3>

    <DataAnnotationsValidator />
    <span style="color: red;"><ValidationSummary /></span>
@if (apiErrors2 != null && apiErrors2.Any())
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            @foreach (var e in apiErrors2)
            {
                <span style="color: red;">
                    <li>@e</li></span>
                }
            </ul>
        </div>
    }
    <div class="mb-3">
        <label><span style="color: red;">*</span>Purchase Ids (comma separated)</label>
            <InputText   class="form-control" @bind-Value="purchaseRequestModel.Ids" placeholder="id1,id2,..." required />
    </div>
    <div class="mb-3">
        <label><span style="color: red;">*</span>Currency</label>
            <InputText  class="form-control" @bind-Value="purchaseRequestModel.Currency" placeholder="India-Rupee" required />
    </div>
    <button class="btn btn-info" >Fetch Conversions</button>

    @if (convertedTransactions != null && convertedTransactions.Any())
    {
        <h4>Converted Transactions</h4>
        <div style="border: 1px solid #dee2e6; border-radius: 0.25rem; overflow: hidden;">
            <table class="table table-striped table-bordered m-0">
                <thead class="table-light">
                    <tr>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Identifier</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Description</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Transaction Date</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Original (USD)</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Exchange Rate Used</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Converted Amount</th>
                        <th style="border: 1px solid #dee2e6; padding: 0.75rem;">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in convertedTransactions)
                    {
                        <tr>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.Purchase.Id</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.Purchase.Description</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.Purchase.TransactionDate.ToString()</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@(t.Purchase.PurchaseAmount.ToString())</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.ExchangeRate?.ToString()</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.ConvertedAmount?.ToString()</td>
                            <td style="border: 1px solid #dee2e6; padding: 0.75rem;">@t.Note?.ToString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</EditForm>

<hr />

@code {
    private PurchaseViewModel editModel = new();
    private PurchaseRequestDTO purchaseRequestModel = new();
    private string queryId = string.Empty;

    // Fields for conversions UI
    private string idsInput = string.Empty;
    private string currency = string.Empty;
    private List<PurchaseWithExchangeRateDTO>? convertedTransactions;

    private PurchaseDTO? savedPurchase;
    private PurchaseDTO? queriedPurchase;

    // API errors to display to the user (rendered in red)
    private List<string> apiErrors = new();
    private List<string> apiErrors2 = new();

    protected override void OnInitialized()
    {
        editModel.TransactionDate = DateTime.UtcNow;
    }

    private async Task HandleValidSubmit()
    {
        apiErrors.Clear();
        apiErrors2.Clear();

        var client = HttpClientFactory.CreateClient("ApiClient");

        var dto = new PurchaseDTO
        {
            Description = editModel.Description ?? string.Empty,
            PurchaseAmount = editModel.PurchaseAmount,
            TransactionDate = editModel.TransactionDate
        };

        var response = await client.PostAsJsonAsync("api/v1/purchase", dto);
        if (response.IsSuccessStatusCode)
        {
            savedPurchase = await response.Content.ReadFromJsonAsync<PurchaseDTO>();
            apiErrors.Clear();
        }
        else
        {
            apiErrors = await ReadErrors(response);
        }
    }

    private async Task GetPurchase()
    {
        apiErrors.Clear();
        apiErrors2.Clear();
        queriedPurchase = null;

        var client = HttpClientFactory.CreateClient("ApiClient");

        if (Guid.TryParse(queryId, out var id))
        {
            var response = await client.GetAsync($"api/v1/purchase/{id}");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();

                if (string.IsNullOrWhiteSpace(content))
                {
                    queriedPurchase = new PurchaseDTO
                    {
                        Description = $"Purchase {id} does not exist"
                    };
                }
                else
                {
                    queriedPurchase = JsonSerializer.Deserialize<PurchaseDTO>(content, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    })!;
                }
                apiErrors.Clear();
                apiErrors2.Clear();
            }
            else
            {
                apiErrors = await ReadErrors(response);
            }
        }
    }

    private async Task FetchConversions()
    {
        convertedTransactions = null;
        apiErrors.Clear();
        apiErrors2.Clear();

     

        var request = new PurchaseRequestDTO
        {
            Ids = idsInput,
            Currency = currency.Trim()
        };

        try
        {
            var client = HttpClientFactory.CreateClient("ApiClient");

            
            var dto = new PurchaseRequestDTO
            {
                Ids = purchaseRequestModel.Ids,
                Currency = purchaseRequestModel.Currency 
            };


            var response = await client.PostAsJsonAsync("api/v1/purchase/transactions/with-conversions", dto);
            if (response.IsSuccessStatusCode)
            {
                convertedTransactions = await response.Content.ReadFromJsonAsync<List<PurchaseWithExchangeRateDTO>>();
                if (convertedTransactions?.Count == 0)
                {
                    apiErrors2 = new List<string> { "No transactions found for the provided Ids." };
                };
                apiErrors.Clear();
               
            }
            else
            {
                apiErrors2 = await ReadErrors(response);
                convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
            }
        }
        catch (Exception ex)
        {
            apiErrors2 = new List<string> { ex.Message };
            convertedTransactions = new List<PurchaseWithExchangeRateDTO>();
        }
    }

    private async Task<List<string>> ReadErrors(HttpResponseMessage response)
    {
        try
        {
            var apiErr = await response.Content.ReadFromJsonAsync<ApiError>();
            if (apiErr?.Errors != null && apiErr.Errors.Any())
            {
                return apiErr.Errors.ToList();
            }

            var txt = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(txt)) return new List<string> { txt };
        }
        catch
        {
            var txt = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(txt)) return new List<string> { txt };
        }

        return new List<string> { $"Request failed with status {(int)response.StatusCode}" };
    }

    private class PurchaseViewModel
    {
        [Required(ErrorMessage = "Description is required.")]
        [StringLength(50, ErrorMessage = "Description cannot exceed 50 characters.")]
        [RegularExpression(@"^[A-Za-z0-9\-\(\),/&\s]+$", ErrorMessage = "Description contains invalid characters. Only letters, numbers, spaces and the characters - ( , ) / & are allowed.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Transaction date is required.")]
        [NotInFuture(ErrorMessage = "Transaction date cannot be in the future.")]
        [DataType(DataType.Date)]
        public DateTime TransactionDate { get; set; }

        [Required(ErrorMessage = "Amount is required.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "Amount must be greater than zero.")]
        public decimal PurchaseAmount { get; set; }
    }

    // Local DTOs so the UI project builds even if the shared BusinessModels project isn't referenced.
    // These mirror the shapes expected by the API calls used on this page.
    private class PurchaseDTO
    {
        public Guid Id { get; set; }
        public string? Description { get; set; }
        public decimal PurchaseAmount { get; set; }
        public DateTime TransactionDate { get; set; }
    }

    private class PurchaseWithExchangeRateDTO
    {
        public PurchaseDTO? Purchase { get; set; }
        public decimal? ExchangeRate { get; set; }
        public decimal? ConvertedAmount { get; set; }
        public string? Note { get; set; }
    }

    private class PurchaseRequestDTO
    {
        [Required(ErrorMessage = "Purchase Ids are required.")]
        public string? Ids { get; set; }
        [Required(ErrorMessage = "Please provide a currency")]
        public string? Currency { get; set; }
    }

    private class ApiError
    {
        public int Status { get; set; }
        public string? Title { get; set; }
        public string? Detail { get; set; }
        public List<string>? Errors { get; set; }
    }

    
    // Add this ValidationAttribute class (also inside the @code block):
    private class NotInFutureAttribute : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
        {
            if (value == null) return ValidationResult.Success; // Required handles null
            if (value is DateTime dt)
            {
                var today = DateTime.UtcNow.Date;
                if (dt.Date > today)
                {
                    return new ValidationResult(ErrorMessage ?? "Date cannot be in the future.");
                }
            }
            return ValidationResult.Success;
        }
    }
}
